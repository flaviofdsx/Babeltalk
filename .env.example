# Copie para .env para desenvolvimento local; nunca coloque chaves reais neste arquivo.

# ============================================================
# CAMADA ADMINISTRADA (recomendado para produção)
# A chave do OpenRouter é administrada pelo criador e nunca
# exposta ao usuário final. Configure uma das opções abaixo:
# ============================================================

# Opção A — chave do admin diretamente (sem proxy)
ADMIN_OPENROUTER_API_KEY=
# Modelo padrão usado pelo proxy administrado
ADMIN_LLM_MODEL=deepseek/deepseek-v4-flash

# Opção B — proxy HTTP gerenciado (se definida, substitui a
# chamada direta ao OpenRouter)
# ADMIN_LLM_PROXY_URL=https://seu-proxy.com/api/suggest

# ============================================================
# LEGADO (apenas para compatibilidade)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
