# Copie para .env para desenvolvimento local; nunca coloque chaves reais neste arquivo.
# Também é possível configurar a chave em Configurações dentro do app.
OPENAI_API_KEY=
# Opcional. Modelo padrão; altere nas configurações do BabelTalk se necessário.
OPENAI_MODEL=gpt-4o-mini

# Para selecionar OpenRouter em Configurações:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
